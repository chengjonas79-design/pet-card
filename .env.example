# ============================================
# 萌宠联萌 - 同品种社交名片 配置文件
# 复制此文件为 .env 并填入真实值
# ============================================

# 腾讯云 CloudBase 环境ID
VITE_CLOUDBASE_ENV_ID=your-cloudbase-env-id

# 微信公众号 AppID
VITE_WX_APPID=your-wechat-appid

# 通义千问 API Key（仅在云函数中使用，不要放前端）
DASHSCOPE_API_KEY=your-dashscope-api-key
