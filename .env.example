# ============================================
# 萌宠联萌 - 同品种社交名片 配置文件
# 复制此文件为 .env 并填入真实值
# ============================================

# 腾讯云 CloudBase 环境ID
VITE_CLOUDBASE_ENV_ID=your-cloudbase-env-id

# 微信公众号 AppID
VITE_WX_APPID=your-wechat-appid

# CloudBase AI 模型配置（云函数 breed-identify 使用）
CLOUDBASE_AI_MODEL_GROUP=hunyuan-exp
CLOUDBASE_AI_MODEL_NAME=hunyuan-vision

# 演示模式：true 时前端使用本地模拟识别，不调用云端大模型
VITE_MOCK_BREED_IDENTIFY=false
