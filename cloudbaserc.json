{
  "envId": "{{env.VITE_CLOUDBASE_ENV_ID}}",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "version": "2.0",
  "framework": {
    "name": "vue",
    "plugins": {
      "client": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "buildCommand": "npm run build",
          "outputPath": "dist",
          "envVariables": {}
        }
      },
      "server": {
        "use": "@cloudbase/framework-plugin-function",
        "inputs": {
          "functionRootPath": "cloudfunctions",
          "functions": [
            {
              "name": "breed-identify",
              "timeout": 30,
              "runtime": "Nodejs18.15",
              "memory": 256,
              "envVariables": {
                "CLOUDBASE_AI_MODEL_GROUP": "{{env.CLOUDBASE_AI_MODEL_GROUP}}",
                "CLOUDBASE_AI_MODEL_NAME": "{{env.CLOUDBASE_AI_MODEL_NAME}}"
              }
            },
            {
              "name": "track-event",
              "timeout": 10,
              "runtime": "Nodejs16.13",
              "memory": 128
            },
            {
              "name": "user-profile",
              "timeout": 10,
              "runtime": "Nodejs16.13",
              "memory": 128
            }
          ]
        }
      }
    }
  }
}
